# A reusable function to save space and avoid copy-paste errors
make_prior_plot <- function(params, label_text, type_val) {
ggplot(data.frame(x = c(0, 1)), aes(x = x)) +
# The Distribution
stat_function(fun = dbeta, args = list(shape1 = params$a, shape2 = params$b),
aes(color = "Beta Prior"), linewidth = 1.2) +
# The Target Line
geom_vline(xintercept = .7, linetype = "dashed", col = "red", alpha = 0.6) +
# Shading
geom_area(stat = "function", fun = dbeta, args = list(shape1 = params$a, shape2 = params$b),
fill = "royalblue", alpha = 0.2) +
scale_color_manual(values = c("Beta Prior" = "royalblue")) +
# Legend Text Construction
annotate("label", x = 0.05, y = Inf, label = label_text,
hjust = 0, vjust = 1.1, size = 3.5, label.size = NA, fill = "white", alpha = 0.8) +
labs(subtitle = paste(type_val, "at 0.7"), x = NULL, y = NULL) +
theme_classic() +
theme(legend.position = "none") # Clean up for a 2x2 grid
}
p1 <- make_prior_plot(first,  paste0("κ = 7\na = ", first$a,  "\nb = ", first$b,  "\nType: Mean"), "Mean")
p2 <- make_prior_plot(second, paste0("κ = 21\na = ", second$a, "\nb = ", second$b, "\nType: Mean"), "Mean")
p3 <- make_prior_plot(third,  paste0("κ = 7\na = ", third$a,  "\nb = ", third$b,  "\nType: Mode"), "Mode")
p4 <- make_prior_plot(fourth, paste0("κ = 21\na = ", fourth$a, "\nb = ", fourth$b, "\nType: Mode"), "Mode")
(p1 + p2) / (p3 + p4) + plot_annotation(title = "Mean vs. Mode: Setting Your Bayesian Prior")
